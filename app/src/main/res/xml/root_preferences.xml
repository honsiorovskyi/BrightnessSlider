<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/grp_general_settings">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/shared_pref_is_globally_enabled"
            android:title="@string/sw_globally_enabled_label" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/grp_slider_settings">

        <SwitchPreference
            android:defaultValue="false"
            android:key="@string/sw_logarithmic_id"
            android:title="@string/sw_logarithmic_label"
            app:summary="@string/sw_logarithmic_summary" />
        <ListPreference
            android:defaultValue="@string/lst_flick_sensitivity_default"
            android:entries="@array/arr_flick_sensitivity_threshold_names"
            android:entryValues="@array/arr_flick_sensitivity_threshold_values"
            android:key="@string/lst_flick_sensitivity_id"
            android:title="@string/lst_flick_sensitivity_label"
            app:summary="@string/lst_flick_sensitivity_summary" />
        <MultiSelectListPreference
            android:defaultValue="@array/arr_lockscreen_gesture_default"
            android:entries="@array/arr_lockscreen_gesture_names"
            android:entryValues="@array/arr_lockscreen_gesture_values"
            android:key="@string/mlst_lockscreen_gestures_id"
            android:title="@string/mlst_lockscreen_gestures_label"
            app:summary="@string/mlst_lockscreen_gestures_summary" />

    </PreferenceCategory>
    <PreferenceCategory
        app:title="@string/grp_slide_actions"
        app:summary="@string/grp_slide_actions_summary">

        <ListPreference
            android:defaultValue="@string/lst_action_single_slide_default"
            android:entries="@array/arr_slide_action_names"
            android:entryValues="@array/arr_slide_action_values"
            android:key="@string/lst_action_single_slide_id"
            android:title="@string/lst_action_single_slide_label"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="@string/lst_action_long_tap_slide_default"
            android:entries="@array/arr_slide_action_names"
            android:entryValues="@array/arr_slide_action_values"
            android:key="@string/lst_action_long_tap_slide_id"
            android:title="@string/lst_action_long_tap_slide_label"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="@string/lst_action_double_tap_slide_default"
            android:entries="@array/arr_slide_action_names"
            android:entryValues="@array/arr_slide_action_values"
            android:key="@string/lst_action_double_tap_slide_id"
            android:title="@string/lst_action_double_tap_slide_label"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/grp_double_tap_actions">

        <ListPreference
            android:defaultValue="@string/lst_action_double_tap_left_default"
            android:entries="@array/arr_tap_action_names"
            android:entryValues="@array/arr_tap_action_values"
            android:key="@string/lst_action_double_tap_left_id"
            android:title="@string/lst_action_double_tap_left_label"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="@string/lst_action_double_tap_middle_default"
            android:entries="@array/arr_tap_action_names"
            android:entryValues="@array/arr_tap_action_values"
            android:key="@string/lst_action_double_tap_middle_id"
            android:title="@string/lst_action_double_tap_middle_label"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="@string/lst_action_double_tap_right_default"
            android:entries="@array/arr_tap_action_names"
            android:entryValues="@array/arr_tap_action_values"
            android:key="@string/lst_action_double_tap_right_id"
            android:title="@string/lst_action_double_tap_right_label"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/grp_double_long_tap_actions">

        <ListPreference
            android:defaultValue="@string/lst_action_double_long_tap_left_default"
            android:entries="@array/arr_tap_action_names"
            android:entryValues="@array/arr_tap_action_values"
            android:key="@string/lst_action_double_long_tap_left_id"
            android:title="@string/lst_action_double_long_tap_left_label"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="@string/lst_action_double_long_tap_right_default"
            android:entries="@array/arr_tap_action_names"
            android:entryValues="@array/arr_tap_action_values"
            android:key="@string/lst_action_double_long_tap_right_id"
            android:title="@string/lst_action_double_long_tap_right_label"
            app:useSimpleSummaryProvider="true" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/grp_back_gesture_settings">

        <ListPreference
            android:defaultValue="@string/lst_back_gesture_edges_default"
            android:entries="@array/arr_back_gesture_edges_names"
            android:entryValues="@array/arr_back_gesture_edges_values"
            android:key="@string/lst_back_gesture_edges_id"
            android:title="@string/lst_back_gesture_edges_label"
            app:summary="@string/lst_back_gesture_edges_summary" />
        <ListPreference
            android:defaultValue="@string/lst_back_gesture_width_default"
            android:entries="@array/arr_back_gesture_width_names"
            android:entryValues="@array/arr_back_gesture_width_values"
            android:key="@string/lst_back_gesture_width_id"
            android:title="@string/lst_back_gesture_width_label"
            app:summary="@string/lst_back_gesture_width_summary" />
        <ListPreference
            android:defaultValue="@string/lst_recents_threshold_default"
            android:entries="@array/arr_recents_threshold_names"
            android:entryValues="@array/arr_recents_threshold_values"
            android:key="@string/lst_recents_threshold_id"
            android:title="@string/lst_recents_threshold_label"
            app:summary="@string/lst_recents_threshold_summary" />

    </PreferenceCategory>

</PreferenceScreen>